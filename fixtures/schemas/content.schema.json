{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fixtures.local/schemas/content.schema.json",
  "title": "Content artifact",
  "description": "Envelope + body contract for observation/provenance content artifacts.",
  "type": "object",
  "required": ["artifact_type", "artifact_id", "version", "tenant_id", "created_at", "body"],
  "additionalProperties": false,
  "properties": {
    "artifact_type": { "const": "content" },
    "artifact_id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "tenant_id": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "body": { "$ref": "#/$defs/contentBody" }
  },
  "$defs": {
    "bbox": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 4,
      "maxItems": 4
    },
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "working",
        "bbox",
        "method",
        "component_version",
        "transform_to_source"
      ],
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "object",
          "required": ["artifact_sha256", "page"],
          "additionalProperties": false,
          "properties": {
            "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "page": { "type": "integer", "minimum": 1 }
          }
        },
        "working": {
          "type": "object",
          "required": ["artifact_sha256", "coordinate_space"],
          "additionalProperties": false,
          "properties": {
            "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "coordinate_space": { "type": "string", "minLength": 1 }
          }
        },
        "bbox": { "$ref": "#/$defs/bbox" },
        "method": { "enum": ["pdf_text", "ocr", "vlm_region", "detector", "human"] },
        "component_version": { "type": "string", "minLength": 1 },
        "transform_to_source": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 6,
          "maxItems": 6
        }
      }
    },
    "confidence": {
      "type": "object",
      "required": ["raw", "calibrated"],
      "additionalProperties": false,
      "properties": {
        "raw": { "type": "number", "minimum": 0, "maximum": 1 },
        "calibrated": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "observation": {
      "type": "object",
      "required": ["element_id", "value", "state", "confidence", "provenance"],
      "additionalProperties": false,
      "properties": {
        "element_id": { "type": "string", "minLength": 1 },
        "value": { "type": ["string", "null"] },
        "state": { "enum": ["present", "empty", "not_applicable", "unreadable", "not_found"] },
        "confidence": { "$ref": "#/$defs/confidence" },
        "provenance": { "$ref": "#/$defs/provenance" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "state": { "const": "present" } },
            "required": ["state"]
          },
          "then": { "properties": { "value": { "type": "string" } }, "required": ["value"] }
        },
        {
          "if": {
            "not": {
              "properties": { "state": { "const": "present" } },
              "required": ["state"]
            }
          },
          "then": { "properties": { "value": { "const": null } } }
        }
      ]
    },
    "unmappedContent": {
      "type": "object",
      "required": ["note_id", "text", "provenance"],
      "additionalProperties": false,
      "properties": {
        "note_id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "coordinateSpace": {
      "type": "object",
      "required": ["id", "page", "width", "height", "unit"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "page": { "type": "integer", "minimum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "unit": { "const": "pt" },
        "dpi": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "templateRef": {
      "type": "object",
      "required": ["template_id", "version"],
      "additionalProperties": false,
      "properties": {
        "template_id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "contentBody": {
      "type": "object",
      "required": [
        "content_id",
        "document_id",
        "version",
        "template_ref",
        "source",
        "coordinate_spaces",
        "observations",
        "unmapped_content"
      ],
      "additionalProperties": false,
      "properties": {
        "content_id": { "type": "string", "minLength": 1 },
        "document_id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "template_ref": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/templateRef" }]
        },
        "source": {
          "type": "object",
          "required": ["sha256", "media_type", "page_count"],
          "additionalProperties": false,
          "properties": {
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "media_type": { "const": "application/pdf" },
            "page_count": { "type": "integer", "minimum": 1 }
          }
        },
        "coordinate_spaces": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/coordinateSpace" }
        },
        "observations": {
          "type": "array",
          "items": { "$ref": "#/$defs/observation" }
        },
        "unmapped_content": {
          "type": "array",
          "items": { "$ref": "#/$defs/unmappedContent" }
        }
      }
    }
  }
}
