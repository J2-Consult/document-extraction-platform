{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fixtures.local/schemas/decoder-mask.schema.json",
  "title": "Decoder-mask artifact",
  "description": "Envelope + body contract for decoder-mask artifacts. Contextual business meaning lives here, nowhere else.",
  "type": "object",
  "required": ["artifact_type", "artifact_id", "version", "tenant_id", "created_at", "body"],
  "additionalProperties": false,
  "properties": {
    "artifact_type": { "const": "decoder_mask" },
    "artifact_id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "tenant_id": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "body": { "$ref": "#/$defs/maskBody" }
  },
  "allOf": [
    {
      "comment": "scope=vendor <=> tenant_id null",
      "if": {
        "properties": { "body": { "properties": { "scope": { "const": "vendor" } }, "required": ["scope"] } },
        "required": ["body"]
      },
      "then": { "properties": { "tenant_id": { "const": null } } }
    },
    {
      "if": {
        "properties": { "body": { "properties": { "scope": { "const": "customer" } }, "required": ["scope"] } },
        "required": ["body"]
      },
      "then": { "properties": { "tenant_id": { "type": "string", "minLength": 1 } } }
    },
    {
      "comment": "vendor-scope masks: every entry has validated_by",
      "if": {
        "properties": { "body": { "properties": { "scope": { "const": "vendor" } }, "required": ["scope"] } },
        "required": ["body"]
      },
      "then": {
        "properties": {
          "body": {
            "properties": {
              "entries": {
                "items": {
                  "properties": {
                    "attribution": { "required": ["validated_by"] }
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "maskRef": {
      "type": "object",
      "required": ["mask_id", "version"],
      "additionalProperties": false,
      "properties": {
        "mask_id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "attribution": {
      "type": "object",
      "required": ["origin", "inherited_from", "overridden"],
      "additionalProperties": false,
      "properties": {
        "origin": { "enum": ["vendor", "customer"] },
        "inherited_from": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/maskRef" }]
        },
        "overridden": { "type": "boolean" },
        "validated_by": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "comment": "overridden => inherited_from non-null",
          "if": { "properties": { "overridden": { "const": true } }, "required": ["overridden"] },
          "then": { "properties": { "inherited_from": { "type": "object" } }, "required": ["inherited_from"] }
        }
      ]
    },
    "target": {
      "type": "object",
      "required": ["schema", "field", "datatype"],
      "additionalProperties": false,
      "properties": {
        "schema": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "datatype": { "enum": ["string", "number", "boolean", "date", "array"] }
      }
    },
    "entry": {
      "type": "object",
      "required": ["element_id", "semantic_role", "target", "attribution"],
      "additionalProperties": false,
      "properties": {
        "element_id": { "type": "string", "minLength": 1 },
        "semantic_role": { "type": "string", "minLength": 1 },
        "target": { "$ref": "#/$defs/target" },
        "enum_map": { "type": "object" },
        "section_path": { "type": "string", "minLength": 1 },
        "attribution": { "$ref": "#/$defs/attribution" }
      }
    },
    "maskBody": {
      "type": "object",
      "required": ["mask_id", "version", "scope", "tenant_id", "template_ref", "system_context", "entries"],
      "additionalProperties": false,
      "properties": {
        "mask_id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "scope": { "enum": ["vendor", "customer"] },
        "tenant_id": { "type": ["string", "null"] },
        "template_ref": {
          "type": "object",
          "required": ["template_id", "version"],
          "additionalProperties": false,
          "properties": {
            "template_id": { "type": "string", "minLength": 1 },
            "version": { "type": "integer", "minimum": 1 }
          }
        },
        "system_context": { "type": "string", "minLength": 1 },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/entry" }
        }
      }
    }
  }
}
