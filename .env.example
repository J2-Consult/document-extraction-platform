# Copy to .env for local development. Never commit .env (see .gitignore).

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=docext
POSTGRES_USER=docext
POSTGRES_PASSWORD=docext_dev_password

# Set by CI to force DB-backed make targets to fail (instead of skip) when
# Postgres is unreachable. Leave false/unset for local development.
CI=false

# E02 restricted service-role passwords (dev/test defaults; override in real
# deployments). Used by the migration runner when creating/converging roles and
# by the isolation suite when connecting as them. Never superuser roles.
DOCEXT_ROLE_API_SERVICE_PASSWORD=api_service_dev_password
DOCEXT_ROLE_WORKER_PASSWORD=worker_dev_password
DOCEXT_ROLE_ORCHESTRATOR_READONLY_PASSWORD=orchestrator_readonly_dev_password
DOCEXT_ROLE_SYNTHESIS_PASSWORD=synthesis_dev_password
